if(NOT DEFINED VERSION_FILE OR NOT EXISTS "${VERSION_FILE}")
    message(FATAL_ERROR "VERSION_FILE missing")
endif()
if(NOT DEFINED PIPELINE_FILE OR NOT EXISTS "${PIPELINE_FILE}")
    message(FATAL_ERROR "PIPELINE_FILE missing")
endif()
if(NOT DEFINED OUTPUT_HEADER OR NOT DEFINED OUTPUT_JSON)
    message(FATAL_ERROR "OUTPUT_HEADER/OUTPUT_JSON missing")
endif()
file(READ "${VERSION_FILE}" version)
string(STRIP "${version}" version)
if(version STREQUAL "")
    message(FATAL_ERROR "VERSION.txt is empty")
endif()
file(STRINGS "${PIPELINE_FILE}" pipeline_lines)
list(LENGTH pipeline_lines pipeline_count)
if(pipeline_count LESS 3)
    message(FATAL_ERROR "PipelineIdentity.txt malformed")
endif()
list(GET pipeline_lines 0 pipeline_abi)
list(GET pipeline_lines 1 cuda_toolkit)
list(GET pipeline_lines 2 msaa)
file(WRITE "${OUTPUT_HEADER}" "#pragma once\n#define LAB_ENGINE_VERSION \"${version}\"\n#define LAB_ENGINE_VERSION_W L\"${version}\"\n")
file(WRITE "${OUTPUT_JSON}" "{\"engine\":\"LaboVR\",\"version\":\"${version}\",\"pipeline_abi\":\"${pipeline_abi}\",\"cuda_architecture\":120,\"cuda_toolkit\":\"${cuda_toolkit}\",\"msaa\":${msaa}}\n")
